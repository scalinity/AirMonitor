[Unit]
Description=AirMonitor SDS011 MQTT Publisher
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=danny
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/danny/airmonitor/venv/bin/python /home/danny/airmonitor/src/publisher.py --broker localhost --serial-port /dev/sds011_new --serial-port-old /dev/sds011_old --interval 85
WorkingDirectory=/home/danny
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
